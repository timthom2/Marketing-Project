[Unit]
Description=TheKey GM Review Portal
After=network.target

[Service]
Type=simple
User=thekey
WorkingDirectory=/home/thekey/thekey-content-bot
Environment="PATH=/home/thekey/thekey-content-bot/venv/bin"
Environment="TZ=America/Toronto"
Environment="PYTHONPATH=/home/thekey/thekey-content-bot/src"
ExecStart=/home/thekey/thekey-content-bot/venv/bin/uvicorn src.web.app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
