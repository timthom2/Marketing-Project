[Unit]
Description=TheKey Review Processor
After=network.target

[Service]
Type=oneshot
User=thekey
WorkingDirectory=/home/thekey/thekey-content-bot
Environment="PATH=/home/thekey/thekey-content-bot/venv/bin"
Environment="TZ=America/Toronto"
Environment="PYTHONPATH=/home/thekey/thekey-content-bot/src"
ExecStart=/home/thekey/thekey-content-bot/venv/bin/python -m src.review.processor
StandardOutput=journal
StandardError=journal
