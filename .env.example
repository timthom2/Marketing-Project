# OpenAI API
OPENAI_API_KEY=

# Email Configuration (Provider-Agnostic SMTP)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false
SMTP_STARTTLS=true
EMAIL_FROM=content-bot@thekey.com
EMAIL_TO=tt@thekey.com

# Optional: Bing Search API (fallback for DuckDuckGo)
BING_API_KEY=

# SERP gap checker (DuckDuckGo)
SERP_GAP_CHECK=true
SERP_MAX_RESULTS=5
SERP_MAX_PAGES=3
SERP_MAX_HEADINGS=8
SERP_TIMEOUT_SECONDS=12
SERP_GAP_CONCURRENCY=2

# Timezone
TZ=America/Toronto

# Pexels image search
# Optional color bias to keep palette neutral (e.g., brown/gray to avoid neon hair/tones)
PEXELS_COLOR_FILTER=brown

# Run mode
# publish = full pipeline with image selection; explore = faster drafts, skip image selection (uses placeholder)
RUN_MODE=publish

# Review workflow
REVIEW_MODE=off
REVIEW_PORTAL_BASE_URL=
# Deadline controls: "next_friday" (default), "next_monday", or "hours"
REVIEW_DEADLINE_MODE=next_friday
REVIEW_DEADLINE_HOURS=48
REVIEW_REMINDER_HOURS=24
REVIEW_REPLY_TO=
REVIEW_FINAL_EMAIL_TO=
REVIEW_PROCESS_ON_SUBMIT=true

# Image proxy/cache for review previews
IMAGE_PROXY_HOSTS=images.pexels.com
IMAGE_CACHE_TTL_HOURS=168
IMAGE_CACHE_MAX_BYTES=10485760
IMAGE_PROXY_TIMEOUT_SECONDS=12

# Run guards
ALLOW_NON_TUESDAY_RUN=false
ALLOW_SAME_DAY_RERUN=false

# Admin UI (review portal)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: store a hash instead of plain password (format: pbkdf2_sha256$iterations$salt$hash)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# Set true when served over HTTPS
ADMIN_COOKIE_SECURE=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/thekey/thekey-content-bot/logs/weekly.log
